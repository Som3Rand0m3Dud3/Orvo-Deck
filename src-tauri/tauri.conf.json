{
	"$schema": "https://schema.tauri.app/config/2",
	"build": {
		"beforeBuildCommand": "deno task build",
		"beforeDevCommand": "deno task dev",
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173"
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"resources": { "target/plugins/": "plugins/" },
		"linux": {
			"deb": {
				"desktopTemplate": "bundle/opendeck.desktop",
				"files": {
					"/etc/udev/rules.d/40-streamdeck.rules": "bundle/40-streamdeck.rules",
					"/usr/share/metainfo/opendeck.metainfo.xml": "bundle/opendeck.metainfo.xml"
				}
			},
			"rpm": {
				"desktopTemplate": "bundle/opendeck.desktop",
				"files": {
					"/etc/udev/rules.d/40-streamdeck.rules": "bundle/40-streamdeck.rules",
					"/usr/share/metainfo/opendeck.metainfo.xml": "bundle/opendeck.metainfo.xml"
				}
			}
		},
		"publisher": "Orvo",
		"shortDescription": "Control app for Orvo devices and stream decks",
		"longDescription": "Orvo Studio is a customizable control app for Orvo macro pads and stream controller devices. Based on OpenDeck by Aman Khanna (nekename).",
		"category": "Productivity",
		"icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
		"macOS": {
			"exceptionDomain": "localhost",
			"signingIdentity": "-"
		}
	},
	"productName": "Orvo Studio",
	"mainBinaryName": "orvo-studio",
	"identifier": "com.orvo.studio",
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["orvo", "openaction", "streamdeck"]
			}
		}
	},
	"app": {
		"windows": [
			{
				"title": "Orvo Studio",
				"fullscreen": false,
				"resizable": true,
				"width": 1280,
				"height": 800,
				"minWidth": 1100,
				"minHeight": 720,
				"center": true,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src * data:; frame-src http://127.0.0.1:*; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://openactionapi.github.io https://api.github.com https://raw.githubusercontent.com https://plugins.amankhanna.me;"
		},
		"withGlobalTauri": true
	}
}
