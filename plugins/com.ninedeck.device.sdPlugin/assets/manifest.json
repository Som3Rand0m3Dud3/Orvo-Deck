{
	"Name": "Orvo M1",
	"Description": "Device support for the Orvo M1 macro pad",
	"Author": "Khaled Alajmi",
	"Version": "0.7.0",
	"Icon": "assets/icon",
	"Category": "Hardware",
	"CodePathWin": "ninedeck-win.exe",
	"CodePathLin": "ninedeck-linux",
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		},
		{
			"Platform": "linux"
		},
		{
			"Platform": "mac",
			"MinimumVersion": "11"
		}
	],
	"Actions": [
		{
			"Name": "Master volume",
			"UUID": "com.ninedeck.device.mastervolume",
			"Icon": "assets/mastervolume",
			"Tooltip": "Slider sets the volume of your speakers or headphones (the Windows default, or ones you choose)",
			"Controllers": [
				"Encoder"
			],
			"States": [
				{
					"Image": "assets/mastervolume",
					"Title": "Master volume"
				}
			],
			"SupportedInMultiActions": false,
			"PropertyInspectorPath": "assets/pi/audiodevice.html"
		},
		{
			"Name": "App volume",
			"UUID": "com.ninedeck.device.appvolume",
			"Icon": "assets/appvolume",
			"Tooltip": "Slider sets one app's volume (e.g. Discord)",
			"Controllers": [
				"Encoder"
			],
			"States": [
				{
					"Image": "assets/appvolume",
					"Title": "App volume"
				}
			],
			"SupportedInMultiActions": false,
			"PropertyInspectorPath": "assets/pi/appvolume.html"
		},
		{
			"Name": "Mic level",
			"UUID": "com.ninedeck.device.miclevel",
			"Icon": "assets/miclevel",
			"Tooltip": "Slider sets a microphone's level (the Windows default, or one you choose)",
			"Controllers": [
				"Encoder"
			],
			"States": [
				{
					"Image": "assets/miclevel",
					"Title": "Mic level"
				}
			],
			"SupportedInMultiActions": false,
			"PropertyInspectorPath": "assets/pi/audiodevice.html"
		},
		{
			"Name": "Play sound",
			"UUID": "com.ninedeck.device.sound",
			"Icon": "assets/sound",
			"Tooltip": "Plays a sound from Orvo's Soundboard into your virtual mic and headphones",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "assets/sound",
					"Title": ""
				}
			],
			"SupportedInMultiActions": true,
			"VisibleInActionsList": false
		},
		{
			"Name": "Soundboard: your voice",
			"UUID": "com.ninedeck.device.sbmic",
			"Icon": "assets/miclevel",
			"Tooltip": "Slider sets how loud your voice is for others (in Orvo's virtual mic)",
			"Controllers": [
				"Encoder"
			],
			"States": [
				{
					"Image": "assets/miclevel",
					"Title": "Your voice"
				}
			],
			"SupportedInMultiActions": false
		},
		{
			"Name": "Soundboard: sounds volume",
			"UUID": "com.ninedeck.device.sbsound",
			"Icon": "assets/sound",
			"Tooltip": "Slider sets the soundboard volume: for everyone, only others, or only you",
			"Controllers": [
				"Encoder"
			],
			"States": [
				{
					"Image": "assets/sound",
					"Title": "Soundboard: sounds volume"
				}
			],
			"SupportedInMultiActions": false,
			"PropertyInspectorPath": "assets/pi/sbsound.html"
		},
		{
			"Name": "Voice changer",
			"UUID": "com.ninedeck.device.voice",
			"Icon": "assets/voice",
			"Tooltip": "Switches your voice (press to toggle, or hold)",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "assets/voice",
					"Title": ""
				}
			],
			"SupportedInMultiActions": true,
			"VisibleInActionsList": false,
			"PropertyInspectorPath": "assets/pi/voice.html"
		},
		{
			"Name": "Voice effects off",
			"UUID": "com.ninedeck.device.voiceoff",
			"Icon": "assets/voice",
			"Tooltip": "Back to your normal (cleaned-up) voice",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "assets/voice",
					"Title": ""
				}
			],
			"SupportedInMultiActions": true,
			"VisibleInActionsList": false
		},
		{
			"Name": "Next voice",
			"UUID": "com.ninedeck.device.voicenext",
			"Icon": "assets/voice",
			"Tooltip": "Steps through the voices",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "assets/voice",
					"Title": ""
				}
			],
			"SupportedInMultiActions": true,
			"VisibleInActionsList": false
		},
		{
			"Name": "Mute my voice",
			"UUID": "com.ninedeck.device.voicemute",
			"Icon": "assets/voice",
			"Tooltip": "Turns your voice in the virtual mic on or off",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "assets/voice",
					"Title": ""
				}
			],
			"SupportedInMultiActions": true,
			"VisibleInActionsList": false
		}
	],
	"DeviceNamespace": "nd",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "6.0"
	},
	"CodePathMac": "ninedeck-mac"
