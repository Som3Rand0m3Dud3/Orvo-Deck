{
	"Name": "NineDeck",
	"Description": "Device support for the NineDeck macro pad",
	"Author": "Khaled Alajmi",
	"Version": "0.3.6",
	"Icon": "assets/icon",
	"Category": "Hardware",
	"CodePathWin": "ninedeck-win.exe",
	"CodePathLin": "ninedeck-linux",
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		},
		{
			"Platform": "linux"
		},
		{
			"Platform": "mac",
			"MinimumVersion": "11"
		}
	],
	"Actions": [
		{
			"Name": "Master volume",
			"UUID": "com.ninedeck.device.mastervolume",
			"Icon": "assets/mastervolume",
			"Tooltip": "Slider sets the Windows volume",
			"Controllers": [
				"Encoder"
			],
			"States": [
				{
					"Image": "assets/mastervolume",
					"Title": "Master volume"
				}
			],
			"SupportedInMultiActions": false
		},
		{
			"Name": "App volume",
			"UUID": "com.ninedeck.device.appvolume",
			"Icon": "assets/appvolume",
			"Tooltip": "Slider sets one app's volume (e.g. Discord)",
			"Controllers": [
				"Encoder"
			],
			"States": [
				{
					"Image": "assets/appvolume",
					"Title": "App volume"
				}
			],
			"SupportedInMultiActions": false,
			"PropertyInspectorPath": "assets/pi/appvolume.html"
		},
		{
			"Name": "Mic level",
			"UUID": "com.ninedeck.device.miclevel",
			"Icon": "assets/miclevel",
			"Tooltip": "Slider sets your microphone level",
			"Controllers": [
				"Encoder"
			],
			"States": [
				{
					"Image": "assets/miclevel",
					"Title": "Mic level"
				}
			],
			"SupportedInMultiActions": false
		}
	],
	"DeviceNamespace": "nd",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "6.0"
	},
	"CodePathMac": "ninedeck-mac"
}
